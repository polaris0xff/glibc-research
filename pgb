#!/bin/sh
# pgb -- build portable static glibc binaries.
#
# Produces an ordinary Linux ELF executable, statically linked against glibc,
# that runs unchanged on glibc and musl distributions. No launcher, no AppDir,
# no packaging format, no runtime beside it: one file you copy and run.
#
# ⛔ WHAT MAKES THIS DIFFERENT FROM `gcc -static`, WHICH IS THE WHOLE POINT.
# A plain `gcc -static` glibc binary is NOT self-contained. Measured across 11
# pinned distributions in experiments/:
#
#   - it reads the HOST /etc/nsswitch.conf and dlopen()s the modules named
#     there, pulling a second libc into the process. That kills it outright on
#     Arch Linux and openSUSE Leap 15.6;
#   - it reaches every character encoding except a small builtin set through
#     dlopen'd gconv modules, which kills it on Debian and Ubuntu and silently
#     costs 11 of 12 tested encodings everywhere else;
#   - it gets an ASCII charset from setlocale() on every musl host.
#
# pgb closes all three. `pgb explain` prints exactly how, and `pgb verify`
# re-measures it on your binary rather than asking you to believe this text.
#
# COMMANDS
#   pgb doctor                 what this machine can and cannot do
#   pgb explain                every flag injected and why. No black box
#   pgb env create             build the pinned, controlled build environment
#   pgb env info               what the environment is, exactly
#   pgb shell                  an interactive shell inside it
#   pgb build [--] CMD...      run a build with the portable toolchain injected
#   pgb cc-dir                 print the wrapper directory, for hand-driving
#   pgb verify BIN             inspect a binary AND run it across the matrix
#   pgb nix SUBCOMMAND         use nixpkgs as the planner: plan, fetch, build
#
# OPTIONS (build)
#   --embed-cacert             find the host's TLS trust store wherever it is,
#                              and carry a copy for hosts that have none
#   --embed-terminfo           carry a handful of terminal descriptions, used
#                              only when the host cannot describe $TERM
#   --embed-locale             embed C.UTF-8, materialised only if the host
#                              lacks it. Off by default: it is the one
#                              mechanism that writes to the filesystem
#   --no-iconv                 do not link GNU libiconv
#   --arch-baseline LEVEL      x86-64 | x86-64-v2 | x86-64-v3 (default x86-64)
#   --bind DIR[:DEST]          expose an extra path inside the environment,
#                              repeatable. Needed when sources, a cache or an
#                              install prefix live outside the current
#                              directory
#   --wrap-dlopen NAME=OBJ[,OBJ...]
#                              answer dlopen("NAME") from a table compiled in
#                              from OBJ, instead of asking the host loader.
#                              Repeatable. OBJ is any object or archive the
#                              build produced; its exported symbols become the
#                              plugin's dlsym table. For programs that load
#                              their OWN plugins
#   --engine chroot|docker|podman|host
#   -v, --verbose              print every wrapped command line
#
# Exit codes: 0 ok, 1 the operation ran and failed, 2 it could not run.
#
# SPDX-License-Identifier: MIT

set -u

PGB_VERSION="0.1.0"
PGB_SELF=$(cd "$(dirname "$0")" && pwd)
PGB_STATE="${PGB_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/pgb}"
PGB_ROOTFS_DIR="${PGB_ROOTFS_DIR:-/var/lib/pgb-rootfs}"
PGB_LIBICONV_PREFIX="${PGB_LIBICONV_PREFIX:-/opt/pgb-libiconv}"

# The build environment, pinned. glibc 2.36 is chosen deliberately and the
# reason is in `pgb env info`: at or above 2.34 the `files` and `dns` NSS
# services are implemented inside libc, which is what leaves the NSS override
# with nothing to dlopen. Below that floor the override moves the dlopen
# instead of removing it.
PGB_ENV_IMAGE="${PGB_ENV_IMAGE:-debian:12}"
PGB_ENV_DIGEST="${PGB_ENV_DIGEST:-sha256:2f65600e1252c5649d2213e1d1ea4d74253d26514dc6530102a875e429245929}"
PGB_ENV_NAME="${PGB_ENV_NAME:-pgb-env-debian12}"
# ⛔ THE BUILD SYSTEMS ARE PART OF THE ENVIRONMENT, AND THEY WERE MISSING.
# `pgb explain` says autotools, CMake, meson and make all pick the wrappers up
# -- true, and it does not help if the environment cannot RUN them. Measured:
# cmake, meson, ninja, autoconf, automake and libtool were all absent from the
# pinned image, so a CMake or meson project could not be built in it at all,
# and an autotools project could only be built from a tarball that already
# carried a generated `configure`. ⚠ That is why all five POCs are autotools
# tarballs: it was the only build system the environment supported, and
# nothing said so. TODO T-016.
# ⛔ AND THE PARSER GENERATORS WERE MISSING TOO, WHICH IS THE SAME DEFECT AS
# THE ONE ABOVE, FOUND THE SAME WAY. `pgb nix build tmux` fetched the source,
# built libevent and ncurses as dependencies, configured, and stopped at
# `configure: error: "yacc not found"`. nixpkgs had already SAID so -- tmux's
# nativeBuildInputs name bison-3.8.2 -- and the environment could not run it.
# bison, flex, gettext and texinfo are what an autotools tarball asks for
# beyond a compiler.
PGB_ENV_PACKAGES="${PGB_ENV_PACKAGES:-gcc g++ make cmake ninja-build meson \
autoconf automake libtool libc6-dev binutils pkg-config file \
xz-utils bzip2 patch perl ca-certificates curl zlib1g-dev libffi-dev \
bison flex gettext texinfo}"

# ⛔ OPTIONS CROSS THE ENGINE BOUNDARY THROUGH THE ENVIRONMENT, NOT THE ARGV.
#
# `pgb build` re-enters itself inside the chroot or container as
# `pgb __inner-build ...`, and that re-entry carries only the user's COMMAND.
# Options parsed by the outer process were therefore silently dropped: a build
# asked for with --embed-locale produced a binary byte-identical to one built
# without it, with no error anywhere. Seeding the defaults from PGB_OPT_* and
# exporting them before re-entry makes the inner process inherit the same
# decisions, and keeps working for the docker engine where argv rewriting
# through `sh -c` would be fragile.
VERBOSE="${PGB_OPT_VERBOSE:-0}"
EMBED_LOCALE="${PGB_OPT_EMBED_LOCALE:-0}"
EMBED_CACERT="${PGB_OPT_EMBED_CACERT:-0}"
EMBED_TERMINFO="${PGB_OPT_EMBED_TERMINFO:-0}"
USE_ICONV="${PGB_OPT_USE_ICONV:-1}"
ARCH_BASELINE="${PGB_OPT_BASELINE:-}"
# Extra paths to expose inside the build environment. A build whose sources,
# cache or prefix live outside the current directory cannot see them
# otherwise, and the failure reads as "cd: can't cd to ..." from inside the
# chroot rather than as a missing mount.
EXTRA_BINDS="${PGB_OPT_BINDS:-}"
# Plugin specs for --wrap-dlopen, one per NAME=OBJECT[,OBJECT...] argument,
# space separated. Crosses the engine boundary through the environment for
# the same reason every other option does.
WRAP_DLOPEN="${PGB_OPT_WRAP_DLOPEN:-}"
ENGINE=""

# ---------------------------------------------------------------------------
# The library. ⛔ SOURCED, so `pgb build` and `pgb verify` stay ONE process --
# each file's own header says why. Order matters only in that `common.sh`
# defines `die`, which the others call.
#
# ⚠ $PGB_SELF is bind-mounted into the build environment and into every target
# rootfs at the same absolute path, so these resolve inside as well as outside.
# ---------------------------------------------------------------------------
for _lib in common wrappers env build verify nix; do
  _libf="$PGB_SELF/tool/lib/$_lib.sh"
  [ -r "$_libf" ] || { printf 'pgb: missing library %s\n' "$_libf" >&2; exit 2; }
  . "$_libf"
done
unset _lib _libf

# ---------------------------------------------------------------------------
CMD=""
ARGS_DONE=0
while [ $# -gt 0 ]; do
  if [ "$ARGS_DONE" = 1 ]; then break; fi
  case "$1" in
    -v|--verbose)     VERBOSE=1 ;;
    --embed-locale)   EMBED_LOCALE=1 ;;
    --embed-cacert)   EMBED_CACERT=1 ;;
    --embed-terminfo) EMBED_TERMINFO=1 ;;
    --no-iconv)       USE_ICONV=0 ;;
    --arch-baseline)  shift; ARCH_BASELINE="${1:-}" ;;
    --bind)           shift; EXTRA_BINDS="$EXTRA_BINDS ${1:-}" ;;
    --wrap-dlopen)    shift; WRAP_DLOPEN="$WRAP_DLOPEN ${1:-}" ;;
    --engine)         shift; ENGINE="${1:-}" ;;
    -h|--help)        usage; exit 0 ;;
    --version)        say "pgb $PGB_VERSION"; exit 0 ;;
    --)               shift; ARGS_DONE=1; break ;;
    -*)               die "unknown option: $1" 2 ;;
    *)                if [ -z "$CMD" ]; then CMD="$1"; else break; fi ;;
  esac
  shift
done

mkdir -p "$PGB_STATE" 2>/dev/null || true

case "${CMD:-}" in
  doctor)         cmd_doctor ;;
  explain)        cmd_explain ;;
  env)            cmd_env "$@" ;;
  build)          cmd_build "$@" ;;
  shell)          cmd_shell ;;
  cc-dir)         build_runtime >/dev/null; make_wrappers; printf '\n' ;;
  verify)         cmd_verify "$@" ;;
  nix)            cmd_nix "$@" ;;
  __inner-build)  inner_build "$@" ;;
  __inner-shell)  inner_build "${SHELL:-/bin/sh}" ;;
  ""|help)        usage ;;
  *)              die "unknown command: $CMD (try: pgb help)" 2 ;;
esac

