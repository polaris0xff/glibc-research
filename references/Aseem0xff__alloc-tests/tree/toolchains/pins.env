# Toolchain pins. Every image installs exactly these, whatever distribution it
# is based on, so the compiler and the Rust toolchain are constants of the
# experiment rather than per-distribution variables.
#
# Changing a value here changes what every future result means, so it is a
# deliberate, reviewable edit -- not something a build resolves at run time.

# The Rust toolchain that compiles ripgrep and the instrument.
# ripgrep 15.2.0 declares rust-version 1.96 in its workspace, so this may not go
# below that.
RUST_VERSION=1.96.0

# zig, used as the OPTIONAL distribution-independent C/C++ toolchain
# (TOOLCHAIN=zig). The distribution's own gcc is the default, because that is
# what a person building in that image actually gets; zig is how the
# distribution axis is controlled for.
ZIG_VERSION=0.16.0
ZIG_SHA256_x86_64=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ZIG_SHA256_aarch64=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17

# Bazel, for the one allocator that requires it. Bazel 9 breaks google/tcmalloc
# (upstream mimalloc-bench issue 258), so it is pinned below that.
BAZEL_VERSION=8.6.0
